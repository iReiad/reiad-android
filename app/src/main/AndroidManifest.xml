<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reading a piece out loud carries on with the app in the
         background, which is the one thing the site's own
         read-aloud cannot do: a browser stops speechSynthesis the
         moment the tab is hidden. mediaPlayback is the honest type
         for it, and POST_NOTIFICATIONS is what puts the Stop
         control where a reader can reach it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A device with no synthesiser at all is a device where the
         button says so rather than one where the app refuses to
         install, so this is a query and not a requirement. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- enableOnBackInvokedCallback turns predictive back on: the
         system draws where the gesture is going as it is dragged,
         rather than after it is finished. Opting in is a promise
         that every back handler here is the callback kind rather
         than the old onBackPressed, and Compose's BackHandler and
         PredictiveBackHandler both are. -->
    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Reiad">

        <!-- singleTop, and it is the sign-in that needs it.

             `MainActivity.onNewIntent` is what reads the redirect
             a Custom Tab comes back on, and the comment beside it
             says so: "onNewIntent is how a redirect arrives when
             the app is ALREADY open, which is the usual case".
             With the default `standard` mode that is never true.
             Android builds a SECOND MainActivity on top of the
             running one instead, with a second view model and a
             second copy of every screen's state, and the reader
             ends up behind their own app with the back button
             walking through two of it.

             `singleTop` makes the documented behaviour the real
             one: the running activity is on top when the tab
             closes, so it receives the intent rather than being
             duplicated. Not `singleTask`, which would also clear
             the back stack on every deep link. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Reiad">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Sign-in comes back here. A scheme the app declares needs
                 no verified App Link, so the account does not wait on a
                 signing fingerprint. See ANDROID.md. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="uk.co.reiad.library" android:host="auth" />
            </intent-filter>

            <!-- The site's own addresses. Inert until a fingerprint is in
                 /.well-known/assetlinks.json, which is deliberate: this
                 is a convenience, not a gate. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="reiad.co.uk" />
                <data android:scheme="https" android:host="www.reiad.co.uk" />
            </intent-filter>

            <!-- Shared TO the app, which is the other direction
                 and the one a browser cannot offer at all.

                 A reader reading the site in Chrome, or seeing the
                 link in a message, can send it here. The text
                 arrives as EXTRA_TEXT rather than as the intent's
                 data, so `MainActivity` pulls the first URL out of
                 it and hands it to the same router: a shared
                 message with a sentence around the link still
                 opens the lesson. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- The three the PWA manifest already declares, same
                 names and same order. Each is a VIEW on a site
                 address, so `core/nav/Address.kt` routes them
                 exactly as it routes a link somebody shared:
                 one function, and a shortcut cannot go stale on
                 its own. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Handing the account export to the share sheet. A
             file:// URI has been refused since Android 7, so a
             copy of anything leaves through a content URI or it
             does not leave. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- The one thing on this list a website cannot do at
             all. The site knows the bookmark and draws a resume
             card on every school hub; a reader still has to open
             a browser, find the tab and press it. This puts the
             same sentence where they already are.

             `updatePeriodMillis="0"`: nothing polls. The widget
             is redrawn when the app writes a bookmark, which is
             the only moment its answer changes. -->
        <receiver
            android:name=".widget.ContinueReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_continue" />
        </receiver>

        <service
            android:name=".read.ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
