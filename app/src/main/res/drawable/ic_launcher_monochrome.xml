<!-- The themed icon, for the launcher that recolours everything
     to the wallpaper. One colour is all that reaches the screen
     here, so the two-tone version's trick of a light ribbon on
     pale pages has nothing to stand on: this draws the same book
     as outlines instead, at the 1.6 stroke weight every other
     icon in `drawable/` uses, scaled to the 108 grid. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M52,47 C47,43 40,41 31,41 L25,41 L25,63 L31,63 C40,63 47,65 52,70 Z" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M56,47 C61,43 68,41 77,41 L83,41 L83,63 L77,63 C68,63 61,65 56,70 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,30 L58,30 L58,58 L54,53.5 L50,58 Z" />
</vector>
