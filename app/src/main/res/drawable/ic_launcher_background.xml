<!-- The launcher's ground. One flat colour, deliberately: an
     adaptive icon's background is dragged, parallaxed and masked
     into whatever shape the launcher wants, and a gradient or a
     pattern under that treatment only ever reads as noise.

     The colour is the green school's own accent at its light
     value, Oklch(0.44 0.090 162) in `core/Palette.kt`, resolved
     to sRGB. Not a second source: if that accent ever moves,
     this hex moves with it in the same commit. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#116243"
        android:pathData="M0,0h108v108h-108z" />
</vector>
